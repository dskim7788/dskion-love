# Anthropic API 키 (https://console.anthropic.com/)
# 설정하지 않으면 채팅은 데모 응답으로 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델 (선택, 기본값 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Replicate API 토큰 (https://replicate.com/account/api-tokens)
# 캐릭터 프로필 사진(AI 이미지 생성)에 사용됩니다. 설정하지 않으면 이모지로 대체됩니다.
REPLICATE_API_TOKEN=

# Auth.js 세션 암호화 키. `openssl rand -base64 32` 또는 `npx auth secret`으로 생성
AUTH_SECRET=

# 카카오 로그인 (https://developers.kakao.com/console/app)
# 앱 생성 후 "카카오 로그인" 활성화, Redirect URI에
# https://<도메인>/api/auth/callback/kakao 및
# http://localhost:3000/api/auth/callback/kakao 등록
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
